# ============================================================
# CERTUS ENGINE — Variáveis de Ambiente Obrigatórias
# Copie este ficheiro para .env.local (desenvolvimento) ou
# configure no dashboard do Vercel (produção).
# NUNCA commite o ficheiro .env.local no Git.
# ============================================================

# [VULN-001] Senha Mestra para geração de chaves de acesso.
# Substitua por um valor forte e aleatório (ex: openssl rand -base64 32)
MASTER_KEY=

# [VULN-003] PIN de administração para a rota /api/admin/stats
# Acesso via: Authorization: Bearer <SEU_PIN>
ADMIN_SECRET_PIN=

# [VULN-005] Links diretos dos SDKs para download (Google Drive ou outro)
# Substitui o shared_links_log.json que estava commitado no Git.
SDK_SOVEREIGN_LINK=
SDK_COMMAND_LINK=

# Vercel KV (gerado automaticamente ao ativar o KV no projeto Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
